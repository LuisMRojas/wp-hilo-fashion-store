{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1360px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Crudo", "color": "#f6f2ec" },
				{ "slug": "surface", "name": "Arena", "color": "#ebe3d7" },
				{ "slug": "contrast", "name": "Tinta", "color": "#1c1a17" },
				{ "slug": "muted", "name": "Piedra", "color": "#6f675d" },
				{ "slug": "accent", "name": "Terracota", "color": "#b5532f" },
				{ "slug": "white", "name": "Blanco", "color": "#ffffff" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "display", "name": "Bodoni Moda", "fontFamily": "\"Bodoni Moda\", \"Didot\", Georgia, serif" },
				{ "slug": "body", "name": "Manrope", "fontFamily": "Manrope, system-ui, -apple-system, \"Segoe UI\", sans-serif" }
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Mínima", "size": "0.75rem" },
				{ "slug": "small", "name": "Pequeña", "size": "0.875rem" },
				{ "slug": "medium", "name": "Media", "size": "1rem" },
				{ "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra grande", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "huge", "name": "Enorme", "size": "5.5rem", "fluid": { "min": "3rem", "max": "5.5rem" } }
			]
		},
		"spacing": {
			"units": ["px", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.25rem, 3vw, 2rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(2rem, 5vw, 4rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(3.5rem, 8vw, 7rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": { "blockGap": "1.25rem", "padding": { "left": "var(--wp--preset--spacing--30)", "right": "var(--wp--preset--spacing--30)" } },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.05", "letterSpacing": "-0.02em" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "999px" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "letterSpacing": "0.04em" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--white)" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "2rem", "fontStyle": "italic", "fontWeight": "500", "letterSpacing": "-0.03em" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/separator": { "color": { "text": "#d9cfc1" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	]
}
